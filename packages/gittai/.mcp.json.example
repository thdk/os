{
  "$schema": "https://github.com/mcp-use/mcp-use/blob/main/schema/mcp-config.schema.json",
  "mcpServers": {
    "git": {
      "command": "npx",
      "args": ["-y", "git-mcp-server@latest"],
      "env": {
        "ALLOWED_OPERATIONS": "read,log,diff,show,status",
        "REPO_PATH": "${CI_PROJECT_DIR:-${PWD}}"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@latest", "${CI_PROJECT_DIR:-${PWD}}"],
      "env": {}
    }
  }
}
